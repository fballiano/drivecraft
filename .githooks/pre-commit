#!/bin/sh
# Runs the same format and lint checks as the CI lint job.
# Enable once per clone: git config core.hooksPath .githooks
# Skip once: git commit --no-verify

# Check only when the commit changes Rust code or Cargo files.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '(\.rs$|Cargo\.(toml|lock)$)'; then
    exit 0
fi

echo "pre-commit: cargo fmt --check"
if ! cargo fmt --all --check; then
    echo "pre-commit: run 'cargo fmt --all', then stage the changes." >&2
    exit 1
fi

echo "pre-commit: cargo clippy"
cargo clippy --workspace --all-targets --locked --quiet -- -D warnings
